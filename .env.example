# 网站访问密码（必填）
SITE_PASSWORD=your-secret-password

# WebDAV 配置（必填）
# 示例：Nextcloud / 坚果云 / Synology 等 WebDAV 根地址
WEBDAV_URL=https://example.com/remote.php/dav/files/username
WEBDAV_USERNAME=username
WEBDAV_PASSWORD=webdav-password

# WebDAV 上的 memos 文件路径（相对 WEBDAV_URL，默认 basic.memos.md）
WEBDAV_FILE_PATH=basic.memos.md

# 可选：会话签名密钥（生产环境强烈建议单独设置，至少 32 位随机字符串）
# 不填则回退使用 SITE_PASSWORD，存在安全风险
AUTH_SECRET=change-me-to-a-long-random-string

# 可选：允许跨域访问的前端地址（逗号分隔，默认同源请求无需配置）
# ALLOWED_ORIGIN=https://your-domain.com
